{
  "name": "@rfnry/thread",
  "version": "0.1.0",
  "type": "module",
  "description": "Conversational text interfaces for humans and machines",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/rfnry/thread.git", "directory": "packages/typescript" },
  "homepage": "https://github.com/rfnry/thread/blob/main/docs/thread.md",
  "bugs": "https://github.com/rfnry/thread/issues",
  "engines": { "node": ">=22.12.0" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "vitest run tests/e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
